    <property name="styleSheet">
     <string notr="true">QPushButton {
    background-color: #141412;
    color: #cca43b;
    border: 1px solid #cca43b;
    border-radius: 6px;
    padding: 8px 16px;
    font-family: &quot;Bahnschrift&quot;, Arial;
    font-size: 20px;
    font-weight: bold;
}

/* Fare üzerine geldiğinde */
QPushButton:hover {
    background-color: #cca43b;
    color: #0d0d0c;
}

/* Butona tıklandığında */
QPushButton:pressed {
    background-color: #b38f32;
    border-color: #b38f32;
    color: #0d0d0c;
}


/* Fare üzerine geldiğinde altın sarısına döner */
QPushButton:hover {
    color: #cca43b;
    border-color: #cca43b;
    background-color: rgba(204, 164, 59, 10); /* Hafif sarımsı transparan arka plan */
}

QPushButton:pressed {
    background-color: rgba(204, 164, 59, 25);
}</string>
