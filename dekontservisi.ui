  <property name="styleSheet">
   <string notr="true">/* Ana Kart Arka Planı */
QFrame#receiptCard {
    background-color: #0d0d0c;
    border: 1px solid rgba(204, 164, 59, 40); /* #cca43b altın renginin transparan hali */
    border-radius: 12px;
}

/* Üst ve Yan Başlıklar */
QLabel {
    color: #958400;
    font-family: &quot;Bahnschrift&quot;, &quot;Arial&quot;;
}

QLabel#titleLabel {
    color: #cca43b;
    font-weight: bold;
    font-size: 11px;
    letter-spacing: 1px;
}

QLabel#subTitleLabel {
    color: #555555;
    font-size: 9px;
}

/* Tutar Paneli */
QFrame#amountBox {
    background-color: #141412;
    border: 1px solid #1a1a1a;
    border-radius: 8px;
}

QLabel#amountLabel {
    color: #cca43b;
    font-size: 26px;
    font-weight: 800;
}

/* Detay Satırlarındaki Sol Sabit Yazılar */
QLabel.detailProp {
    color: #888888;
    font-size: 12px;
}

/* Detay Satırlarındaki Sağ Değer Yazıları */
QLabel.detailValue {
    color: #f0f0f0;
    font-size: 12px;
    font-weight: 600;
}

/* Yatay Ayırıcı Çizgiler */
QFrame[frameShape=&quot;HLine&quot;] {
    background-color: #1a1a1a;
    height: 1px;
    border: none;
}</string>
