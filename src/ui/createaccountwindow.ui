  <property name="styleSheet">
   <string notr="true">/* Ana Pencere ve Genel Arkaplan */
QWidget {
    background-color: #ffffff;
    color: #000000;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 10pt;
}

/* Giriş Alanları (LineEdit, TextEdit vb.) */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 8px;
    color: #ffffff;
    selection-background-color: #3d5afe;
}

QLineEdit:focus {
    border: 2px solid #3d5afe;
}

/* Buton Tasarımı */
QPushButton {
    background-color: #00aaff;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #536dfe;
}

QPushButton:pressed {
    background-color: #2641e0;
}

/* Listeler ve Tablolar */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    alternate-background-color: #252525;
    show-decoration-selected: 1;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #3d5afe;
    border-radius: 4px;
}

/* Kaydırma Çubukları (Scrollbar) - Modern İnce Görünüm */
QScrollBar:vertical {
    border: none;
    background: #121212;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #444444;
}

/* Checkbox (Onay Kutusu) */
QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #5c5c5c;
    border-radius: 4px;
    background: transparent;
}

QCheckBox::indicator:checked {
    background-color: #3d5afe;
    border: 2px solid #3d5afe;
    border-radius: 4px;
    image: url(check_icon.svg); /* Varsa ikon ekleyebilirsin */
}
</string>
